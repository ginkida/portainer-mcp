# Required
PORTAINER_URL=https://portainer.example.com:9443
# Authentication: EITHER an access token (preferred; Portainer → My account → Access tokens)
#PORTAINER_API_KEY=ptr_xxxxxxxxxxxxxxxxxxxx
# ...OR username + password (ignored when PORTAINER_API_KEY is set)
PORTAINER_USERNAME=admin
PORTAINER_PASSWORD=your-password-here

# Optional — values below are the defaults
PORTAINER_DEFAULT_ENDPOINT=1
PORTAINER_VERIFY_SSL=true
# Timeout (seconds) for ordinary API calls
#PORTAINER_TIMEOUT=30
# Timeout (seconds) for slow operations: image pull, exec, large log scans
#PORTAINER_LONG_TIMEOUT=300
# HTTP connection pool sizing
#PORTAINER_HTTP_MAX_CONNECTIONS=100
#PORTAINER_HTTP_MAX_KEEPALIVE=20
# Proactive JWT refresh interval (seconds); keep below Portainer's session timeout (default 8h)
#PORTAINER_JWT_TTL=25200
# Register the Laravel helpers (portainer_laravel_errors / portainer_laravel_tinker)
#PORTAINER_ENABLE_LARAVEL_TOOLS=false
